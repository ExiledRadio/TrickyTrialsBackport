{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "up": "true"
          },
          {
            "north": "false",
            "east": "false",
            "south": "false",
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "trickytrialsbackport:resin_brick_wall_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "trickytrialsbackport:resin_brick_wall_side",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "trickytrialsbackport:resin_brick_wall_side",
        "uvlock": true,
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "trickytrialsbackport:resin_brick_wall_side",
        "uvlock": true,
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "trickytrialsbackport:resin_brick_wall_side",
        "uvlock": true,
        "y": 270
      }
    }
  ]
}
